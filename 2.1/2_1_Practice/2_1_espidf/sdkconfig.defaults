# Тік FreeRTOS 1 мс (як в Arduino). За замовчуванням в ESP-IDF 100 Гц,
# і pdMS_TO_TICKS(1) дав би 0.
CONFIG_FREERTOS_HZ=1000

# Оптимізація -Os (як в Arduino). За замовчуванням ESP-IDF збирає з -Og (Debug),
# і з ним крок 2 НЕ зависає без volatile: компілятор не виносить читання з циклу.
# Баг, який ховається в debug-збірці і з'являється в release, - окремий урок.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
